# Model access. Set one of these; without either, the app runs with the offline demo extractor.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model override. OpenRouter IDs look like anthropic/claude-haiku-5.5.
ANTHROPIC_MODEL=

# Postgres connection string (Neon). Leave empty locally to use the embedded database in .local/db.
DATABASE_URL=

# Optional: Vercel Blob token, only needed for uploads over 4 MB on Vercel.
BLOB_READ_WRITE_TOKEN=

# Set to true to force the offline demo extractor even when a key is present.
DEMO_MODE=
